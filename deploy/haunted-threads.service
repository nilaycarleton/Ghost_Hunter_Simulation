[Unit]
Description=Haunted Threads
Documentation=https://hauntedthreads.site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/HauntedThreads
Environment=NODE_ENV=production
ExecStart=/usr/bin/node web/server.mjs
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/HauntedThreads/data

[Install]
WantedBy=multi-user.target
